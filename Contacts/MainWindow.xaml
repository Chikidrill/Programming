<Window x:Class="Contacts.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Converters"
        mc:Ignorable="d"
        Title="Contacts" 
        Icon="contacts_icon.ico"
        MinHeight="420"  
        MinWidth="550" 
        Height="400" 
        Width="500" >

    <Window.Resources>
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" MinWidth="150"/>
            <ColumnDefinition Width="3" />
            <ColumnDefinition Width="3*" MinWidth="200"/>
        </Grid.ColumnDefinitions>

        <Grid 
            Grid.Column="0" 
            Background="#f8f8f8" 
            Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label 
                    Content="Find:" 
                    Margin="3" 
                    VerticalAlignment="Center"/>
                <TextBox 
                    x:Name="SearchTextBox" 
                    Grid.Column="1" Margin="3" 
                    VerticalAlignment="Center"/>
            </Grid>

            <ListBox 
                x:Name="ContactsListBox" 
                Grid.Row="1" 
                Margin="8"
                ItemsSource="{Binding Contacts}"
                SelectedItem="{Binding SelectedContact, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Row="2" Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button 
                    Content="Add" 
                    Height="25" 
                    Margin="3"
                    HorizontalAlignment="Stretch"
                    Grid.Column="0"
                    Command="{Binding AddCommand}"
                    />
                <Button 
                    Content="Edit" 
                    Height="25" 
                    Margin="3"
                    Command="{Binding EditCommand}"
                    Grid.Column="1"
                    IsEnabled="{Binding IsContactReadOnly}"/>
                <Button 
                    Content="Remove" 
                    Height="25" 
                    Margin="3"
                    Command="{Binding RemoveCommand}"
                    Grid.Column="2"
                    IsEnabled="{Binding IsContactReadOnly}"/>
            </Grid>
        </Grid>

        <GridSplitter 
            Grid.Column="1" 
            Width="3" 
            Background="White" 
            HorizontalAlignment="Stretch"/>

        <Grid 
            Grid.Column="2" 
            Background="White" 
            Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="2*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Image 
                    Grid.Column="0" 
                    Width="100" 
                    Height="100" 
                    Margin="6,35,5,0" 
                    VerticalAlignment="Top" 
                    Source="photo_placeholder.png" Grid.RowSpan="2"/>

                <StackPanel Grid.Column="1" Grid.RowSpan="2">
                    <Label 
                        Content="Name:" 
                        Margin="0,3,0,3" 
                        HorizontalAlignment="Left"/>
                    <TextBox 
                        Text="{Binding SelectedContact.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                        Margin="0,3,0,3"
                        IsReadOnly="{Binding IsContactReadOnly}"/>
                    <Label 
                        Content="Phone Number:" 
                        Margin="0,3,0,3" 
                        HorizontalAlignment="Left"/>
                    <TextBox 
                        Text="{Binding SelectedContact.PhoneNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                        Margin="0,3,0,3"
                        IsReadOnly="{Binding IsContactReadOnly}"/>
                    <Label 
                        Content="Email:" 
                        Margin="0,3,0,3" 
                        HorizontalAlignment="Left"/>
                    <TextBox 
                        Text="{Binding SelectedContact.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                        Margin="0,3,0,3"
                        IsReadOnly="{Binding IsContactReadOnly}"/>
                    <Button 
                         Content="Apply" 
                         Height="25" 
                         Width="75"
                         Margin="0,50,0,0"
                         Command="{Binding ApplyCommand}" 
                         HorizontalAlignment="Left" 
                         VerticalAlignment="Bottom"
                         Visibility="{Binding IsDataChanged, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
